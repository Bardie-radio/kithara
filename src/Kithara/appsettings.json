{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModuleChannel": {
    "UseMtls": true,
    "BootstrapMode": "Auto",
    "TlsDataPath": "data/mtls",
    "ServerDnsNames": [ "kithara", "localhost" ]
  },
  "ModuleRegistry": {
    "HeartbeatTtl": "00:01:30",
    "NextHeartbeatAfterSeconds": 30
  },
  "BlobStorage": {
    "Driver": "local",
    "Path": "data/blobs"
  },
  "Neck": {
    "StrunaFifoRoot": "data/struna-fifos",
    "Mp3BitrateKbps": 128
  }
}
